# API server
PORT=4000

# Change this in production — sessions are signed with it.
JWT_SECRET=hinga-dev-secret-change-me

# SQLite file location (relative to the server/ workspace).
DB_PATH=./data/hinga.db

# Allowed browser origin for the storefront. Leave unset to allow any origin (dev).
CORS_ORIGIN=http://localhost:5173

# Shared access code required when someone signs up as an administrator.
# Unset in production disables admin self sign-up. Locally it falls back to
# "hinga-admin" so the flow works straight after `npm run dev`.
ADMIN_SIGNUP_CODE=hinga-admin
