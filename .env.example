# API server
PORT=4000

# Change this in production — sessions are signed with it.
JWT_SECRET=hinga-dev-secret-change-me

# SQLite file location (relative to the server/ workspace).
DB_PATH=./data/hinga.db

# Durable database for deployments without a persistent disk (Vercel and other
# serverless hosts). When these are set the API stores everything in a hosted
# libSQL/Turso database instead of the SQLite file above, so accounts, orders
# and uploaded images survive restarts. Leave them empty for local development.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Allowed browser origin for the storefront. Leave unset to allow any origin (dev).
CORS_ORIGIN=http://localhost:5173

# Shared access code required when someone signs up as an administrator.
# Unset in production disables admin self sign-up. Locally it falls back to
# "samhin-admin" so the flow works straight after `npm run dev`.
ADMIN_SIGNUP_CODE=samhin-admin

# Bootstrap administrator. If the database has no admin (for example after a
# cold start with ephemeral storage), this account is recreated so the owner can
# log in instead of registering again. Change these in production.
ADMIN_NAME=Hinga Admin
ADMIN_EMAIL=admin@hinga.shop
ADMIN_PASSWORD=admin1234
